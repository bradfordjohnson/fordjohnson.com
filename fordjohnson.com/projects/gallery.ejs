```{=html}
<% for (const item of items) { %>

<section class="projects-listing">

  <header class="projects-heading">
    <h2><%- item.category %></h2>
    <p><%- item.description %></p>
  </header>

  <% for (let index = 0; index < item.tiles.length; index++) {
    const tile = item.tiles[index];
  %>

  <article class="project-feature" <%= metadataAttrs(tile) %>>

    <div class="project-copy <%= index % 2 ? 'project-reverse' : '' %>">

      <div class="project-details">

        <span class="project-number">
          <%= String(index + 1).padStart(2, '0') %>
        </span>

        <h3 class="project-title">
          <%= tile.title %>
        </h3>

        <% if (tile.subtitle) { %>
        <p class="project-subtitle">
          <%= tile.subtitle %>
        </p>
        <% } %>


        <div class="project-actions">

        <% if (tile.href) { %>
        <a href="<%- tile.href %>" class="project-link">
            <%= tile.cta || 'Explore project' %>
            <i class="bi bi-arrow-up-right" aria-hidden="true"></i>
        </a>
        <% } else { %>
        <span class="project-status">
            <%= tile.cta || 'In development' %>
        </span>
        <% } %>

        <% if (tile.code && tile.code !== tile.href) { %>
        <a href="<%- tile.code %>" class="project-source">
            <i class="bi bi-code-slash" aria-hidden="true"></i>
            View source
        </a>
        <% } %>

        </div>


      </div>

      <div class="project-visual">

        <% if (tile.href) { %>
        <a href="<%- tile.href %>"
           tabindex="-1"
           aria-hidden="true">
        <% } %>

          <img
            src="<%- tile.thumbnail %>"
            alt="<%= tile.alt || tile.title + ' project preview' %>"
            loading="lazy" />

        <% if (tile.href) { %>
        </a>
        <% } %>

      </div>

    </div>

  </article>

  <% } %>

</section>

<% } %>

```
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "rootDir": "_src/ts",
    "outDir": "_assets/_js",
    "lib": ["ES2020", "DOM"],
    "sourceMap": true
  },
  "include": ["_src/ts/**/*.ts"],
  "exclude": ["node_modules"]
}